+    along with this program.  If not, see <http://www.gnu.org/licenses/>.
+******************/
+
+#include "scheme.hpp"
+
+// Usage: expand <filename> <n> [<m> <l>] <outdir>
+//
+// Writes the scheme and every scheme reachable by one flip (both
+// orientations) to <outdir>/vertices/<canonical-hash>.exp and appends the
+// connecting edges to <outdir>/edges.txt. Deterministic: findFlips
+// enumerates by row index, no randomness.
+int main(int argc, char* argv[]){
+  int n, m, l;
+  string filename, outdir;
+  if(argc == 4){
+    filename = argv[1];
+    n = m = l = *argv[2]-'0';
+    outdir = argv[3];
+  }
+  else if(argc == 6){
+    filename = argv[1];
+    n = *argv[2]-'0';
+    m = *argv[3]-'0';
+    l = *argv[4]-'0';
+    outdir = argv[5];
+  }
+  else{
+    cerr << "Usage: " << argv[0] << " <filename> <n> [<m> <l>] <outdir>" << endl;
+    return 1;
+  }
+  Scheme s(filename, n, m, l);
+  if(!s.check()){
+    cerr << "Opened incorrect scheme: " << filename << endl;
+    return 1;
+  }
+  string base = canonname(s);
+  s.write(outdir + "/vertices/" + base);
+  ofstream edges(outdir + "/edges.txt", ios_base::app);
+  unordered_set<string> seen;
+  vector<Flip> flips = s.findFlips();
+  for(Flip f : flips){
+    for(int o = 0; o < 2; ++o){
+      Scheme t(s);
+      if(o == 0){
+        t.flip(f.col, f.row1, f.row2);
+      }
+      else{
+        t.flip(f.col, f.row2, f.row1);
+      }
+      // Skip flips that zero out a factor: the result is not a set of
+      // nonzero rank-one terms, so it is not a flip-graph vertex.
+      bool degenerate = false;
+      for(int r = 0; r < t.rank && !degenerate; ++r){
+        for(int k = 0; k < 3; ++k){
+          if(t.rows[r][k] == 0){
+            degenerate = true;
+            break;
+          }
+        }
+      }
+      if(degenerate){
+        continue;
+      }
+      if(!t.check()){
+        cerr << "Flip produced incorrect scheme from: " << filename << endl;
+        return 1;
+      }
+      string name = canonname(t);
+      if(seen.insert(name).second){
+        t.write(outdir + "/vertices/" + name);
+        edges << base << " " << name << "\n";
+      }
+    }
+  }
+  cout << base << " neighbors: " << seen.size() << endl;
+  return 0;
+}
