+
+/****************
+    Trace instrumentation added 2026-08-20 for exporting flip-graph walk
+    datasets. Distributed under the same GPLv3-or-later terms as the rest
+    of this program.
+
+    When the FLIP_TRACE environment variable names an existing directory
+    containing a vertices/ subdirectory, every visited scheme is written to
+    vertices/<canonical-hash>.exp and every accepted transition is appended
+    to edges.txt in walk order.
+******************/
+
+#undef get
+#undef set
+#undef unset
+#include <algorithm>
+#include <array>
+
+static string tracedir;
+static ofstream traceedges;
+static unordered_set<string> traceseen;
+static string tracelast;
+
+// Canonical filename: FNV-1a over the row triples sorted lexicographically,
+// so the row order of a scheme does not affect its vertex identity.
+string canonname(const Scheme& s){
+  vector<array<mat,3>> t(s.rank);
+  for(int i = 0; i < s.rank; ++i){
+    t[i] = {s.rows[i][0], s.rows[i][1], s.rows[i][2]};
+  }
+  sort(t.begin(), t.end());
+  unsigned long long h = 1469598103934665603ULL;
+  for(auto &r : t){
+    for(int k = 0; k < 3; ++k){
+      for(int b = 0; b < 8; ++b){
+        h ^= (r[k] >> (8*b)) & 0xff;
+        h *= 1099511628211ULL;
+      }
+    }
+  }
+  stringstream stream;
+  stream << setfill('0') << setw(16) << hex << h;
+  return stream.str() + ".exp";
+}
+
+void tracestate(Scheme& s){
+  if(tracedir.empty()){
+    return;
+  }
+  string name = canonname(s);
+  if(traceseen.insert(name).second){
+    s.write(tracedir + "/vertices/" + name);
+  }
+  if(!tracelast.empty()){
+    traceedges << tracelast << " " << name << "\n";
+  }
+  tracelast = name;
+}
+
+void traceinit(Scheme& s){
+  const char* dir = getenv("FLIP_TRACE");
+  if(dir == NULL){
+    return;
+  }
+  tracedir = dir;
+  traceedges.open(tracedir + "/edges.txt", ios_base::app);
+  tracestate(s);
+}
