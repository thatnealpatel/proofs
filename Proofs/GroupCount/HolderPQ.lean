import GroupCount.Gnu

/-!
# Hölder's classification at order `p * q`

For primes `p < q`, Hölder's classical formula is

`gnu (p * q) = if p ∣ q - 1 then 2 else 1`.

This module formalizes the classification from Mathlib's Sylow, cyclic-group, and
semidirect-product APIs.  Every Sylow `q`-subgroup of a group of order `p * q` has order
`q` and is normal.  It proves uniqueness, by order, of subgroups of a finite cyclic
group and the resulting uniqueness of injective actions of a prime cyclic group up to
an automorphism of the source.  When `p ∣ q - 1`, Cauchy's theorem supplies an
automorphism of `C_q` of order `p`; the resulting `C_q ⋊ C_p` is explicitly shown to
have order `p * q` and noncommuting elements.  These ingredients give the full formula
above.

The mathematical source is the ROUTE paragraph “Hölder’s classical formula for groups
of order `p*q`” in `Formalize/A046057-dennis-surjectivity.md`; Dennis's surjectivity
conjecture is not addressed.
-/

set_option autoImplicit false

namespace GroupCount

/-- If primes `p < q` satisfy `p ∣ q - 1`, the canonical cyclic group of order `q`
has an automorphism of order `p`; its semidirect product with the subgroup generated by
that automorphism has order `p * q` and contains two noncommuting elements. -/
theorem exists_semidirectProduct_card_mul_primes_noncommutative
    {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p < q)
    (hdvd : p ∣ q - 1) :
    ∃ (σ : MulAut (Multiplicative (ZMod q))) (_hσ : orderOf σ = p),
      let H := Subgroup.zpowers σ
      let φ : H →* MulAut (Multiplicative (ZMod q)) := H.subtype
      Nonempty (Fintype (Multiplicative (ZMod q) ⋊[φ] H)) ∧
        Nat.card (Multiplicative (ZMod q) ⋊[φ] H) = p * q ∧
        ∃ x y : Multiplicative (ZMod q) ⋊[φ] H, x * y ≠ y * x := by
  letI : NeZero q := ⟨Nat.ne_of_gt (hp.pos.trans hpq)⟩
  let N := Multiplicative (ZMod q)
  letI : Fintype N := inferInstanceAs (Fintype (Multiplicative (ZMod q)))
  have hNcard : Nat.card N = q :=
    (Nat.card_congr Multiplicative.toAdd).trans (Nat.card_zmod q)
  letI : Fact p.Prime := ⟨hp⟩
  have hcardAut : Nat.card (MulAut N) = q - 1 := by
    rw [IsCyclic.card_mulAut, hNcard, Nat.totient_prime hq]
  obtain ⟨σ, hσ⟩ := exists_prime_orderOf_dvd_card' (G := MulAut N) p
    (hcardAut ▸ hdvd)
  refine ⟨σ, hσ, ?_⟩
  let H := Subgroup.zpowers σ
  let φ : H →* MulAut N := H.subtype
  have hHcard : Nat.card H = p := by
    rw [Nat.card_zpowers, hσ]
  constructor
  · exact ⟨Fintype.ofEquiv (N × H) SemidirectProduct.equivProd.symm⟩
  constructor
  · rw [SemidirectProduct.card, hNcard, hHcard, Nat.mul_comm]
  · have hσ_ne : σ ≠ 1 := by
      intro heq
      rw [heq, orderOf_one] at hσ
      exact hp.ne_one hσ.symm
    obtain ⟨n, hn⟩ : ∃ n : N, σ n ≠ n := by
      by_contra hnone
      apply hσ_ne
      apply DFunLike.ext σ 1
      intro n
      exact Classical.not_not.mp ((not_exists.mp hnone) n)
    let s : H := ⟨σ, Subgroup.mem_zpowers σ⟩
    let x : N ⋊[φ] H := SemidirectProduct.inr s
    let y : N ⋊[φ] H := SemidirectProduct.inl n
    refine ⟨x, y, fun hcomm => hn ?_⟩
    have hleft := congrArg SemidirectProduct.left hcomm
    simpa [x, y, φ, s] using hleft

/-- For distinct primes `p < q`, the exponent of `q` in `p * q` is exactly one. -/
theorem factorization_mul_primes_right {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p < q) : (p * q).factorization q = 1 := by
  rw [Nat.factorization_mul_of_coprime
    (Nat.Coprime.symm (hq.coprime_iff_not_dvd.mpr ?_))]
  · rw [hp.factorization, hq.factorization]
    simp [hpq.ne]
  · exact fun hdvd => (Nat.not_le_of_lt hpq) (Nat.le_of_dvd hp.pos hdvd)

/-- In a finite group of order `p * q`, where `p < q` are prime, every Sylow
`q`-subgroup has cardinality `q`. -/
theorem sylow_card_eq_larger_prime {G : Type*} [Group G] [Finite G] {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p < q) (hcard : Nat.card G = p * q)
    (Q : Sylow q G) : Nat.card Q = q := by
  letI : Fact q.Prime := ⟨hq⟩
  rw [Sylow.card_eq_multiplicity, hcard, factorization_mul_primes_right hp hq hpq,
    pow_one]

/-- In a finite group of order `p * q`, where `p < q` are prime, every Sylow
`q`-subgroup is normal.  This is the normal Hall subgroup in Hölder's classification. -/
theorem sylow_larger_prime_normal {G : Type*} [Group G] [Finite G] {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p < q) (hcard : Nat.card G = p * q)
    (Q : Sylow q G) : Q.Normal := by
  letI : Fact q.Prime := ⟨hq⟩
  have hQ : Nat.card Q = q := sylow_card_eq_larger_prime hp hq hpq hcard Q
  have hindex : Q.index = p := by
    have hmul := Q.1.card_mul_index
    rw [hQ, hcard] at hmul
    apply Nat.eq_of_mul_eq_mul_left hq.pos
    simpa [Nat.mul_comm] using hmul
  have hdvd : Nat.card (Sylow q G) ∣ p := by
    rw [← hindex]
    exact Q.card_dvd_index
  have hone_or : Nat.card (Sylow q G) = 1 ∨ Nat.card (Sylow q G) = p :=
    (Nat.dvd_prime hp).mp hdvd
  have hone : Nat.card (Sylow q G) = 1 := by
    rcases hone_or with hone | heq
    · exact hone
    · have hmod := card_sylow_modEq_one q G
      rw [heq] at hmod
      have hpone : p = 1 := hmod.eq_of_lt_of_lt hpq hq.one_lt
      omega
  letI : Subsingleton (Sylow q G) := (Nat.card_eq_one_iff_unique.mp hone).1
  exact Q.normal_of_subsingleton

/-- Two subgroups with the same finite cardinality in a finite cyclic group are equal.
The proof explicitly identifies both with the subgroup generated by
`a ^ (Nat.card A / d)` for a generator `a` of the ambient group. -/
theorem subgroup_eq_of_isCyclic_card_eq {A : Type*} [Group A] [Finite A] [IsCyclic A]
    (S T : Subgroup A) {d : ℕ} (hd : 0 < d) (hS : Nat.card S = d)
    (hT : Nat.card T = d) : S = T := by
  obtain ⟨a, ha⟩ := IsCyclic.exists_monoid_generator (α := A)
  have hza : ∀ x : A, x ∈ Subgroup.zpowers a := by
    intro x
    rw [← (isOfFinOrder_of_finite a).mem_powers_iff_mem_zpowers]
    exact ha x
  have hoa : orderOf a = Nat.card A := orderOf_eq_card_of_forall_mem_zpowers hza
  have hddvd : d ∣ Nat.card A := hS ▸ S.card_subgroup_dvd_card
  let c := a ^ (Nat.card A / d)
  have hoc : orderOf c = d := by
    rw [orderOf_pow, hoa]
    have hdiv : Nat.card A / d ∣ Nat.card A := Nat.div_dvd_of_dvd hddvd
    rw [Nat.gcd_eq_right_iff_dvd.mpr hdiv]
    exact Nat.div_div_self hddvd Nat.card_pos.ne'
  have hcardc : Nat.card (Subgroup.zpowers c) = d := by
    rw [Nat.card_zpowers, hoc]
  have hle : ∀ U : Subgroup A, Nat.card U = d → U ≤ Subgroup.zpowers c := by
    intro U hU
    obtain ⟨u, hu⟩ := IsCyclic.exists_generator (α := U)
    obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff u.1 a).mp (ha u.1)
    have hou : orderOf u.1 = d := by
      rw [Subgroup.orderOf_coe, orderOf_eq_card_of_forall_mem_zpowers hu, hU]
    have hgcd : (Nat.card A).gcd k = Nat.card A / d := by
      have heq : Nat.card A / (Nat.card A).gcd k = d := by
        rw [← hoa, ← orderOf_pow, hk, hou]
      have hgcd_dvd : (Nat.card A).gcd k ∣ Nat.card A := Nat.gcd_dvd_left _ _
      have hgcd_pos : 0 < (Nat.card A).gcd k :=
        Nat.gcd_pos_of_pos_left k Nat.card_pos
      have hmul : Nat.card A = d * (Nat.card A).gcd k :=
        (Nat.div_eq_iff_eq_mul_left hgcd_pos hgcd_dvd).mp heq
      exact ((Nat.div_eq_iff_eq_mul_left hd hddvd).mpr
        (by simpa [Nat.mul_comm] using hmul)).symm
    have hdk : Nat.card A / d ∣ k := by
      rw [← hgcd]
      exact Nat.gcd_dvd_right _ _
    have huc : u.1 ∈ Subgroup.zpowers c := by
      obtain ⟨j, rfl⟩ := hdk
      rw [← hk, pow_mul]
      change c ^ j ∈ Subgroup.zpowers c
      exact (Subgroup.zpowers c).pow_mem (Subgroup.mem_zpowers c) j
    intro x hx
    obtain ⟨z, hz⟩ := hu ⟨x, hx⟩
    have hzx : (u ^ z).1 = x := congrArg Subtype.val hz
    rw [← hzx]
    exact (Subgroup.zpowers c).zpow_mem huc z
  have hSc : S = Subgroup.zpowers c :=
    Subgroup.eq_of_le_of_card_ge (hle S hS) (by rw [hcardc, hS])
  have hTc : T = Subgroup.zpowers c :=
    Subgroup.eq_of_le_of_card_ge (hle T hT) (by rw [hcardc, hT])
  exact hSc.trans hTc.symm

/-- Two injective homomorphisms from a group of prime order into a finite cyclic group
differ by an automorphism of their common source. -/
theorem injective_hom_eq_comp_mulEquiv {K A : Type*} [Group K] [Group A]
    [Finite K] [Finite A] [IsCyclic A] {p : ℕ} (hp : p.Prime)
    (hK : Nat.card K = p) (f g : K →* A) (hf : Function.Injective f)
    (hg : Function.Injective g) : ∃ e : K ≃* K, ∀ x, f x = g (e x) := by
  have hfcard : Nat.card f.range = p := by
    rw [← hK]
    exact (Nat.card_congr (MonoidHom.ofInjective hf).toEquiv).symm
  have hgcard : Nat.card g.range = p := by
    rw [← hK]
    exact (Nat.card_congr (MonoidHom.ofInjective hg).toEquiv).symm
  have hrange : f.range = g.range :=
    subgroup_eq_of_isCyclic_card_eq f.range g.range hp.pos hfcard hgcard
  let e := (MonoidHom.ofInjective hf).trans
    ((MulEquiv.subgroupCongr hrange).trans (MonoidHom.ofInjective hg).symm)
  refine ⟨e, fun x => ?_⟩
  change f x = g ((MonoidHom.ofInjective hg).symm
    (MulEquiv.subgroupCongr hrange ((MonoidHom.ofInjective hf) x)))
  rw [MonoidHom.apply_ofInjective_symm]
  rfl

section GroundTruth

example : (2 * 3).factorization 3 = 1 :=
  factorization_mul_primes_right Nat.prime_two Nat.prime_three (by omega)

example (Q : Sylow 3 (Multiplicative (ZMod 6))) : Q.Normal :=
  sylow_larger_prime_normal Nat.prime_two Nat.prime_three (by omega) (by simp) Q

example : (⊤ : Subgroup (Multiplicative (ZMod 5))) = ⊤ :=
  subgroup_eq_of_isCyclic_card_eq ⊤ ⊤ (d := 5) (by omega) (by simp) (by simp)

example : ∃ e : Multiplicative (ZMod 2) ≃* Multiplicative (ZMod 2),
    ∀ x, MonoidHom.id _ x = MonoidHom.id _ (e x) :=
  injective_hom_eq_comp_mulEquiv Nat.prime_two (by simp) (MonoidHom.id _)
    (MonoidHom.id _) Function.injective_id Function.injective_id

end GroundTruth

