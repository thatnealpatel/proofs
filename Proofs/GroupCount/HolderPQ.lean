/-- If a finite group is a noncyclic internal semidirect product with a cyclic
normal factor and a cyclic prime-order complement, then its conjugation action is
injective. -/
theorem semidirect_action_injective_of_not_isCyclic {G : Type*} [Group G] [Finite G]
    {N H : Subgroup G} [N.Normal] (hcomp : N.IsComplement' H)
    [IsCyclic N] [IsCyclic H] {p : ℕ} (hp : p.Prime) (hH : Nat.card H = p)
    (hcop : (Nat.card N).Coprime (Nat.card H)) (hncyc : ¬ IsCyclic G) :
    Function.Injective (N.normalizerMonoidHom.comp
      (Subgroup.inclusion (N.normalizer_eq_top ▸ le_top : H ≤ Subgroup.normalizer N))) := by
  let hHN : H ≤ Subgroup.normalizer N := N.normalizer_eq_top ▸ le_top
  let φ := N.normalizerMonoidHom.comp (Subgroup.inclusion hHN)
  have hker : φ.ker = ⊥ := by
    letI : Fact (Nat.card H).Prime := ⟨hH.symm ▸ hp⟩
    rcases @Subgroup.eq_bot_or_eq_top_of_prime_card H _ φ.ker _ with hbot | htop
    · exact hbot
    · exfalso
      have hφ : φ = 1 := by
        apply MonoidHom.ext
        intro x
        have hx : x ∈ φ.ker := by rw [htop]; exact Subgroup.mem_top x
        exact MonoidHom.mem_ker.mp hx
      have hcyc : IsCyclic (N ⋊[φ] H) := by
        rw [hφ]
        haveI : IsCyclic (N × H) :=
          Group.isCyclic_prod_iff.mpr ⟨inferInstance, inferInstance, hcop⟩
        exact isCyclic_of_surjective SemidirectProduct.mulEquivProd.symm
          SemidirectProduct.mulEquivProd.symm.surjective
      haveI : IsCyclic (N ⋊[φ] H) := hcyc
      exact hncyc (isCyclic_of_surjective (SemidirectProduct.mulEquivSubgroup hcomp)
        (SemidirectProduct.mulEquivSubgroup hcomp).surjective)
  exact φ.ker_eq_bot_iff.mp hker

/-- Every finite group of order `p * q`, for primes `p < q`, admits cyclic
subgroups `N` and `H` of respective orders `q` and `p`, and an action `φ` for which
the external semidirect product `N ⋊[φ] H` is isomorphic to the group. -/
theorem exists_pq_semidirect_decomposition {G : Type*} [Group G] [Finite G]
    {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p < q)
    (hcard : Nat.card G = p * q) :
    ∃ (N H : Subgroup G) (φ : H →* MulAut N),
      Nat.card N = q ∧ Nat.card H = p ∧ IsCyclic N ∧ IsCyclic H ∧
      (Nat.card N).Coprime (Nat.card H) ∧ Nonempty (N ⋊[φ] H ≃* G) := by
  letI : Fact p.Prime := ⟨hp⟩
  letI : Fact q.Prime := ⟨hq⟩
  let N : Sylow q G := Classical.choice inferInstance
  have hNcard : Nat.card N = q := sylow_card_eq_larger_prime hp hq hpq hcard N
  letI : (N : Subgroup G).Normal := sylow_larger_prime_normal hp hq hpq hcard N
  have hindex : (N : Subgroup G).index = p := by
    have hmul := (N : Subgroup G).card_mul_index
    rw [hNcard, hcard] at hmul
    apply Nat.eq_of_mul_eq_mul_left hq.pos
    simpa [Nat.mul_comm] using hmul
  have hcop : (Nat.card N).Coprime (N : Subgroup G).index := by
    rw [hNcard, hindex]
    exact Nat.Coprime.symm (hp.coprime_iff_not_dvd.mpr fun hdvd => by
      rcases (Nat.dvd_prime hq).mp hdvd with hone | heq
      · exact hp.ne_one hone
      · exact hpq.ne heq)
  obtain ⟨H, hHN⟩ := Subgroup.exists_left_complement'_of_coprime hcop
  have hHcard : Nat.card H = p := by rw [← hindex, hHN.index_eq_card]
  have hcycN : IsCyclic N := isCyclic_of_prime_card hNcard
  have hcycH : IsCyclic H := isCyclic_of_prime_card hHcard
  let φ := (N : Subgroup G).normalizerMonoidHom.comp
    (Subgroup.inclusion ((N : Subgroup G).normalizer_eq_top ▸ le_top :
      H ≤ Subgroup.normalizer N))
  exact ⟨N, H, φ, hNcard, hHcard, hcycN, hcycH,
    by
      rw [hNcard, hHcard]
      rw [hNcard, hindex] at hcop
      exact hcop,
    ⟨SemidirectProduct.mulEquivSubgroup hHN.symm⟩⟩

/-- Semidirect products of cyclic groups of respective prime orders `q` and `p`
with injective actions are isomorphic.  This is the uniqueness of the nonabelian
isomorphism class in Hölder's order-`p*q` classification. -/
theorem semidirect_products_mulEquiv_of_injective
    {N₁ H₁ N₂ H₂ : Type*} [Group N₁] [Group H₁] [Group N₂] [Group H₂]
    [Finite N₁] [Finite H₁] [Finite N₂] [Finite H₂]
    [IsCyclic N₁] [IsCyclic H₁] [IsCyclic N₂] [IsCyclic H₂]
    {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hN₁ : Nat.card N₁ = q) (hH₁ : Nat.card H₁ = p)
    (hN₂ : Nat.card N₂ = q) (hH₂ : Nat.card H₂ = p)
    (φ₁ : H₁ →* MulAut N₁) (φ₂ : H₂ →* MulAut N₂)
    (hφ₁ : Function.Injective φ₁) (hφ₂ : Function.Injective φ₂) :
    Nonempty (N₁ ⋊[φ₁] H₁ ≃* N₂ ⋊[φ₂] H₂) := by
  letI : Fact (Nat.card N₂).Prime := ⟨hN₂.symm ▸ hq⟩
  haveI : IsCyclic (MulAut N₂) := isCyclic_of_injective
    (IsCyclic.mulAutMulEquiv N₂).toMonoidHom (IsCyclic.mulAutMulEquiv N₂).injective
  let fn : N₁ ≃* N₂ := mulEquivOfCyclicCardEq (hN₁.trans hN₂.symm)
  let fh : H₁ ≃* H₂ := mulEquivOfCyclicCardEq (hH₁.trans hH₂.symm)
  let α : H₁ →* MulAut N₂ := (MulAut.congr fn).toMonoidHom.comp φ₁
  let β : H₁ →* MulAut N₂ := φ₂.comp fh.toMonoidHom
  have hα : Function.Injective α := (MulAut.congr fn).injective.comp hφ₁
  have hβ : Function.Injective β := hφ₂.comp fh.injective
  obtain ⟨e, he⟩ := injective_hom_eq_comp_mulEquiv hp hH₁ α β hα hβ
  let fg : H₁ ≃* H₂ := e.trans fh
  refine ⟨SemidirectProduct.congr fn fg ?_⟩
  intro g
  ext n
  have heval := DFunLike.congr_fun (he g) (fn n)
  simpa [α, β, fg, MulAut.congr_apply] using heval

/-- A noncyclic group isomorphic to a semidirect product with a prime-order
cyclic acting factor has injective action, provided the two factor orders are coprime. -/
theorem semidirect_action_injective_of_noncyclic_target
    {G N H : Type*} [Group G] [Group N] [Group H]
    [Finite G] [Finite N] [Finite H] [IsCyclic N] [IsCyclic H]
    {φ : H →* MulAut N} {p : ℕ} (hp : p.Prime) (hH : Nat.card H = p)
    (hcop : (Nat.card N).Coprime (Nat.card H)) (e : N ⋊[φ] H ≃* G)
    (hncyc : ¬ IsCyclic G) : Function.Injective φ := by
  have hker : φ.ker = ⊥ := by
    letI : Fact (Nat.card H).Prime := ⟨hH.symm ▸ hp⟩
    rcases @Subgroup.eq_bot_or_eq_top_of_prime_card H _ φ.ker _ with hbot | htop
    · exact hbot
    · exfalso
      have hφ : φ = 1 := by
        apply MonoidHom.ext
        intro x
        have hx : x ∈ φ.ker := by rw [htop]; exact Subgroup.mem_top x
        exact MonoidHom.mem_ker.mp hx
      have hcyc : IsCyclic (N ⋊[φ] H) := by
        rw [hφ]
        haveI : IsCyclic (N × H) :=
          Group.isCyclic_prod_iff.mpr ⟨inferInstance, inferInstance, hcop⟩
        exact isCyclic_of_surjective SemidirectProduct.mulEquivProd.symm
          SemidirectProduct.mulEquivProd.symm.surjective
      haveI : IsCyclic (N ⋊[φ] H) := hcyc
      exact hncyc (isCyclic_of_surjective e e.surjective)
  exact φ.ker_eq_bot_iff.mp hker

/-- Any two noncyclic finite groups of order `p * q`, for primes `p < q`, are
isomorphic.  Thus Hölder's classification has at most one nonabelian class. -/
theorem nonempty_mulEquiv_of_card_eq_mul_primes_of_not_isCyclic
    {G₁ G₂ : Type*} [Group G₁] [Group G₂] [Finite G₁] [Finite G₂]
    {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hpq : p < q)
    (hG₁ : Nat.card G₁ = p * q) (hG₂ : Nat.card G₂ = p * q)
    (hncyc₁ : ¬ IsCyclic G₁) (hncyc₂ : ¬ IsCyclic G₂) :
    Nonempty (G₁ ≃* G₂) := by
  obtain ⟨N₁, H₁, φ₁, hN₁, hH₁, hcycN₁, hcycH₁, hcop₁, ⟨e₁⟩⟩ :=
    exists_pq_semidirect_decomposition hp hq hpq hG₁
  obtain ⟨N₂, H₂, φ₂, hN₂, hH₂, hcycN₂, hcycH₂, hcop₂, ⟨e₂⟩⟩ :=
    exists_pq_semidirect_decomposition hp hq hpq hG₂
  letI : IsCyclic N₁ := hcycN₁
  letI : IsCyclic H₁ := hcycH₁
  letI : IsCyclic N₂ := hcycN₂
  letI : IsCyclic H₂ := hcycH₂
  have hinj₁ : Function.Injective φ₁ :=
    semidirect_action_injective_of_noncyclic_target hp hH₁ hcop₁ e₁ hncyc₁
  have hinj₂ : Function.Injective φ₂ :=
    semidirect_action_injective_of_noncyclic_target hp hH₂ hcop₂ e₂ hncyc₂
  obtain ⟨e⟩ := semidirect_products_mulEquiv_of_injective hp hq hN₁ hH₁ hN₂ hH₂
    φ₁ φ₂ hinj₁ hinj₂
  exact ⟨e₁.symm.trans (e.trans e₂)⟩

/-- A noncyclic finite group of order `p * q`, with primes `p < q`, forces
`p ∣ q - 1`.  The injective complement action embeds a group of order `p` in the
cyclic automorphism group of the normal subgroup of order `q`. -/
theorem dvd_pred_of_card_eq_mul_primes_of_not_isCyclic
    {G : Type*} [Group G] [Finite G] {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p < q)
    (hcard : Nat.card G = p * q) (hncyc : ¬ IsCyclic G) : p ∣ q - 1 := by
  obtain ⟨N, H, φ, hN, hH, hcycN, hcycH, hcop, ⟨e⟩⟩ :=
    exists_pq_semidirect_decomposition hp hq hpq hcard
  letI : IsCyclic N := hcycN
  letI : IsCyclic H := hcycH
  have hinj : Function.Injective φ :=
    semidirect_action_injective_of_noncyclic_target hp hH hcop e hncyc
  have hrange : Nat.card φ.range = p := by
    rw [← hH]
    exact (Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv).symm
  have hdvd : Nat.card φ.range ∣ Nat.card (MulAut N) := φ.range.card_subgroup_dvd_card
  rw [hrange, IsCyclic.card_mulAut, hN, Nat.totient_prime hq] at hdvd
  exact hdvd

/-- If `p < q` are prime and `p` does not divide `q - 1`, every group of order
`p * q` is cyclic, so there is exactly one isomorphism class. -/
theorem gnu_mul_primes_of_not_dvd {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p < q) (hndvd : ¬ p ∣ q - 1) : gnu (p * q) = 1 := by
  apply gnu_eq_one_iff.mpr
  refine ⟨by nlinarith [hp.one_lt, hq.one_lt], fun S T => ?_⟩
  have hcycS : IsCyclic S.Carrier := by
    by_contra hncyc
    exact hndvd (dvd_pred_of_card_eq_mul_primes_of_not_isCyclic hp hq hpq
      S.natCard_carrier hncyc)
  have hcycT : IsCyclic T.Carrier := by
    by_contra hncyc
    exact hndvd (dvd_pred_of_card_eq_mul_primes_of_not_isCyclic hp hq hpq
      T.natCard_carrier hncyc)
  letI : IsCyclic S.Carrier := hcycS
  letI : IsCyclic T.Carrier := hcycT
  exact (GroupStructure.iso_iff_nonempty_mulEquiv S T).mpr
    ⟨mulEquivOfCyclicCardEq (by simp)⟩

/-- If primes `p < q` satisfy `p ∣ q - 1`, there are exactly two isomorphism classes
of groups of order `p * q`: the cyclic group and one noncyclic semidirect product. -/
theorem gnu_mul_primes_of_dvd {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p < q) (hdvd : p ∣ q - 1) : gnu (p * q) = 2 := by
  obtain ⟨σ, hσ, hrest⟩ :=
    exists_semidirectProduct_card_mul_primes_noncommutative hp hq hpq hdvd
  let H := Subgroup.zpowers σ
  let φ : H →* MulAut (Multiplicative (ZMod q)) := H.subtype
  let G := Multiplicative (ZMod q) ⋊[φ] H
  change Nonempty (Fintype G) ∧ Nat.card G = p * q ∧
    ∃ x y : G, x * y ≠ y * x at hrest
  obtain ⟨hfin, hGcard, x, y, hxy⟩ := hrest
  letI : Fintype G := Classical.choice hfin
  have hGcardF : Fintype.card G = p * q := by
    simpa only [Nat.card_eq_fintype_card] using hGcard
  have hGnotcyclic : ¬ IsCyclic G := by
    intro hcyc
    letI : IsCyclic G := hcyc
    exact hxy (Std.Commutative.comm x y)
  letI : NeZero (p * q) := ⟨Nat.mul_ne_zero hp.ne_zero hq.ne_zero⟩
  obtain ⟨T, ⟨eG⟩⟩ := GroupStructure.exists_carrier_mulEquiv hGcardF
  have hcyclic_not_iso : ¬ (GroupStructure.cyclic (p * q)).Iso T := by
    intro hiso
    obtain ⟨eCT⟩ := (GroupStructure.iso_iff_nonempty_mulEquiv _ _).mp hiso
    have hcycT : IsCyclic T.Carrier :=
      isCyclic_of_surjective eCT eCT.surjective
    letI : IsCyclic T.Carrier := hcycT
    exact hGnotcyclic (isCyclic_of_surjective eG.symm eG.symm.surjective)
  have key : Fintype.card Bool = gnu (p * q) := by
    refine card_eq_gnu_of_classification
      (fun b => cond b T (GroupStructure.cyclic (p * q))) ?_ ?_
    · intro S
      by_cases hcycS : IsCyclic S.Carrier
      · refine ⟨false, ?_⟩
        show (GroupStructure.cyclic (p * q)).Iso S
        letI : IsCyclic S.Carrier := hcycS
        exact (GroupStructure.iso_iff_nonempty_mulEquiv _ S).mpr
          ⟨mulEquivOfCyclicCardEq (by simp)⟩
      · refine ⟨true, ?_⟩
        show T.Iso S
        obtain ⟨eS⟩ := nonempty_mulEquiv_of_card_eq_mul_primes_of_not_isCyclic
          hp hq hpq hGcard S.natCard_carrier hGnotcyclic hcycS
        exact (GroupStructure.iso_iff_nonempty_mulEquiv T S).mpr
          ⟨eG.symm.trans eS⟩
    · intro i j hij
      cases i <;> cases j
      · rfl
      · exact absurd hij hcyclic_not_iso
      · exact absurd hij.symm hcyclic_not_iso
      · rfl
  rw [← key]
  exact Fintype.card_bool

/-- Hölder's formula: for primes `p < q`, the number of groups of order `p * q` is
two exactly when `p ∣ q - 1`, and one otherwise. -/
theorem gnu_mul_primes {p q : ℕ} (hp : p.Prime) (hq : q.Prime)
    (hpq : p < q) : gnu (p * q) = if p ∣ q - 1 then 2 else 1 := by
  by_cases hdvd : p ∣ q - 1
  · rw [if_pos hdvd]
    exact gnu_mul_primes_of_dvd hp hq hpq hdvd
  · rw [if_neg hdvd]
    exact gnu_mul_primes_of_not_dvd hp hq hpq hdvd

section GroundTruth

example : Nat.Prime 2 ∧ Nat.Prime 3 ∧ 2 < 3 ∧ 2 ∣ 3 - 1 := by norm_num

example : gnu (2 * 3) = if 2 ∣ 3 - 1 then 2 else 1 :=
  gnu_mul_primes Nat.prime_two Nat.prime_three (by omega)

end GroundTruth

