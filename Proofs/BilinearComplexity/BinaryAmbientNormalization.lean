import BilinearComplexity.BinaryAmbientTensorCoordinates
import BilinearComplexity.NormalizedBinaryRelationEnumeration
import BilinearComplexity.NormalizedBinaryFiveCircuitRows

set_option autoImplicit false

/-!
# Exact-span normalization of ambient binary endpoints

An `ExactSpanPresentation` is the executable boundary of ambient
normalization: its coordinate equivalences are supplied data, never selected
by a basis choice.  Endpoint terms are first restricted to the exact factor
spans generated by their union and are then normalized through that supplied
presentation.  Choice-based existence of presentations is confined to the
final proof-side construction.
-/

namespace BilinearComplexity.BinaryAmbientNormalization

open scoped TensorProduct BigOperators
open NormalizedBinaryCarrier (F2)

universe u v w

/-- The ambient term carrier: an ordered triple of nonzero vectors in the
three supplied factor spaces. -/
abbrev AmbientCarrier
    (U : Type u) (V : Type v) (W : Type w)
    [Zero U] [Zero V] [Zero W] :=
  BinaryAmbientCarrier.Carrier U V W

/-- A finite state of ambient nonzero-factor triples. -/
abbrev AmbientState
    (U : Type u) (V : Type v) (W : Type w)
    [Zero U] [Zero V] [Zero W] :=
  BinaryAmbientCarrier.State U V W

/-- Executable coordinates on the three exact factor spans generated jointly
by the ordered ambient endpoints. -/
structure ExactSpanPresentation
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (A B : AmbientState U V W) where
  profile : NormalizedBinaryCarrier.Profile
  firstCoordinates :
    BinaryAmbientTensorCoordinates.Coord profile.first ≃ₗ[F2]
      BinaryAmbientCarrier.firstSpan (A ∪ B)
  secondCoordinates :
    BinaryAmbientTensorCoordinates.Coord profile.second ≃ₗ[F2]
      BinaryAmbientCarrier.secondSpan (A ∪ B)
  thirdCoordinates :
    BinaryAmbientTensorCoordinates.Coord profile.third ≃ₗ[F2]
      BinaryAmbientCarrier.thirdSpan (A ∪ B)

/-- The first profile coordinate is forced by the first exact span. -/
theorem ExactSpanPresentation.first_eq_finrank
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    P.profile.first = Module.finrank F2 (BinaryAmbientCarrier.firstSpan (A ∪ B)) := by
  rw [← P.firstCoordinates.finrank_eq]
  exact (Module.finrank_fin_fun (R := F2) (n := P.profile.first)).symm

/-- The second profile coordinate is forced by the second exact span. -/
theorem ExactSpanPresentation.second_eq_finrank
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    P.profile.second = Module.finrank F2 (BinaryAmbientCarrier.secondSpan (A ∪ B)) := by
  rw [← P.secondCoordinates.finrank_eq]
  exact (Module.finrank_fin_fun (R := F2) (n := P.profile.second)).symm

/-- The third profile coordinate is forced by the third exact span. -/
theorem ExactSpanPresentation.third_eq_finrank
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    P.profile.third = Module.finrank F2 (BinaryAmbientCarrier.thirdSpan (A ∪ B)) := by
  rw [← P.thirdCoordinates.finrank_eq]
  exact (Module.finrank_fin_fun (R := F2) (n := P.profile.third)).symm

/-- Any two supplied presentations of the same endpoints have the same forced
profile, independently of their coordinate bases. -/
theorem ExactSpanPresentation.profile_eq
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P Q : ExactSpanPresentation A B) :
    P.profile = Q.profile := by
  have hfirst : P.profile.first = Q.profile.first := by
    rw [P.first_eq_finrank, Q.first_eq_finrank]
  have hsecond : P.profile.second = Q.profile.second := by
    rw [P.second_eq_finrank, Q.second_eq_finrank]
  have hthird : P.profile.third = Q.profile.third := by
    rw [P.third_eq_finrank, Q.third_eq_finrank]
  cases hp : P.profile
  cases hq : Q.profile
  simp_all

/-- Restrict one term known to lie in a state to that state's three exact
factor spans. -/
def restrictTerm
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) (t : AmbientCarrier U V W) (ht : t ∈ K) :
    AmbientCarrier (BinaryAmbientCarrier.firstSpan K)
      (BinaryAmbientCarrier.secondSpan K)
      (BinaryAmbientCarrier.thirdSpan K) :=
  (⟨⟨t.1.1, BinaryAmbientCarrier.first_mem_firstSpan ht⟩,
      fun h => t.1.2 (congrArg Subtype.val h)⟩,
    ⟨⟨t.2.1.1, BinaryAmbientCarrier.second_mem_secondSpan ht⟩,
      fun h => t.2.1.2 (congrArg Subtype.val h)⟩,
    ⟨⟨t.2.2.1, BinaryAmbientCarrier.third_mem_thirdSpan ht⟩,
      fun h => t.2.2.2 (congrArg Subtype.val h)⟩)

/-- Forget exact-span subtype information from one restricted term. -/
def includeTerm
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) :
    AmbientCarrier (BinaryAmbientCarrier.firstSpan K)
        (BinaryAmbientCarrier.secondSpan K)
        (BinaryAmbientCarrier.thirdSpan K) →
      AmbientCarrier U V W :=
  fun t =>
    (⟨t.1.1.1, fun h => t.1.2 (Subtype.ext h)⟩,
      ⟨t.2.1.1.1, fun h => t.2.1.2 (Subtype.ext h)⟩,
      ⟨t.2.2.1.1, fun h => t.2.2.2 (Subtype.ext h)⟩)

/-- Restricting a term to the exact spans generated by `K` and then
forgetting the subtype witnesses recovers the original ambient term. -/
@[simp] theorem includeTerm_restrictTerm
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) (t : AmbientCarrier U V W) (ht : t ∈ K) :
    includeTerm K (restrictTerm K t ht) = t := by
  rfl

/-- Forgetting exact-span subtype information is injective. -/
theorem includeTerm_injective
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) : Function.Injective (includeTerm K) := by
  intro s t hst
  apply Prod.ext
  · apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun q : AmbientCarrier U V W => q.1.1) hst
  · apply Prod.ext
    · apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun q : AmbientCarrier U V W => q.2.1.1) hst
    · apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun q : AmbientCarrier U V W => q.2.2.1) hst

/-- The embedding of exact-span terms into the original ambient carrier. -/
def includeTermEmbedding
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) :
    AmbientCarrier (BinaryAmbientCarrier.firstSpan K)
        (BinaryAmbientCarrier.secondSpan K)
        (BinaryAmbientCarrier.thirdSpan K) ↪ AmbientCarrier U V W :=
  ⟨includeTerm K, includeTerm_injective K⟩

/-- Restrict a substate of `K` termwise to the exact spans generated by `K`. -/
def restrictState
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K D : AmbientState U V W) (hDK : D ⊆ K) :
    AmbientState (BinaryAmbientCarrier.firstSpan K)
      (BinaryAmbientCarrier.secondSpan K)
      (BinaryAmbientCarrier.thirdSpan K) :=
  D.attach.map
    { toFun := fun t => restrictTerm K t.1 (hDK t.2)
      inj' := by
        intro s t hst
        apply Subtype.ext
        simpa using congrArg (includeTerm K) hst }

/-- Include a finite exact-span state into the original ambient state. -/
def includeState
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W)
    (D : AmbientState (BinaryAmbientCarrier.firstSpan K)
      (BinaryAmbientCarrier.secondSpan K)
      (BinaryAmbientCarrier.thirdSpan K)) : AmbientState U V W :=
  D.map (includeTermEmbedding K)

/-- Restriction followed by inclusion reconstructs the original substate. -/
@[simp] theorem includeState_restrictState
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K D : AmbientState U V W) (hDK : D ⊆ K) :
    includeState K (restrictState K D hDK) = D := by
  rw [includeState, restrictState, Finset.map_map]
  convert Finset.attach_map_val using 1
  ext t
  rfl

/-- Restriction preserves finite-state cardinality. -/
@[simp] theorem restrictState_card
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K D : AmbientState U V W) (hDK : D ⊆ K) :
    (restrictState K D hDK).card = D.card := by
  simp [restrictState]

/-- Restriction of two substates preserves and reflects disjointness. -/
@[simp] theorem restrictState_disjoint_iff
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K D E : AmbientState U V W) (hDK : D ⊆ K) (hEK : E ⊆ K) :
    Disjoint (restrictState K D hDK) (restrictState K E hEK) ↔
      Disjoint D E := by
  rw [← Finset.disjoint_map (includeTermEmbedding K)]
  change Disjoint (includeState K (restrictState K D hDK))
    (includeState K (restrictState K E hEK)) ↔ Disjoint D E
  rw [includeState_restrictState, includeState_restrictState]

/-- A constructive decidable equality on restricted terms, inherited through
the injective inclusion into the supplied ambient carrier. -/
def restrictedCarrierDecidableEq
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) :
    DecidableEq (AmbientCarrier (BinaryAmbientCarrier.firstSpan K)
      (BinaryAmbientCarrier.secondSpan K)
      (BinaryAmbientCarrier.thirdSpan K)) :=
  fun s t => decidable_of_iff (includeTerm K s = includeTerm K t)
    (includeTerm_injective K).eq_iff

/-- Normalize an arbitrary substate of the endpoint union through a supplied
exact-span presentation. -/
def normalizeSubstate
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B)
    (D : AmbientState U V W) (hD : D ⊆ A ∪ B) :
    NormalizedBinaryCarrier.State P.profile :=
  BinaryAmbientTensorCoordinates.normalizeState P.firstCoordinates
    P.secondCoordinates P.thirdCoordinates
    (restrictState (A ∪ B) D hD)

/-- The normalized left endpoint, preserving the ordered endpoint slot. -/
def normalizedLeft
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    NormalizedBinaryCarrier.State P.profile :=
  normalizeSubstate P A (Finset.subset_union_left)

/-- The normalized right endpoint, preserving the ordered endpoint slot. -/
def normalizedRight
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    NormalizedBinaryCarrier.State P.profile :=
  normalizeSubstate P B (Finset.subset_union_right)

/-- Ordered normalized endpoints derived from an exact-span presentation. -/
def normalizedEndpoints
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    NormalizedBinaryFiniteAction.RelationEndpoints P.profile where
  left := normalizedLeft P
  right := normalizedRight P

/-- Restriction commutes with unions of substates. -/
theorem restrictState_union
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K D E : AmbientState U V W) (hD : D ⊆ K) (hE : E ⊆ K) :
    letI := restrictedCarrierDecidableEq K
    restrictState K D hD ∪ restrictState K E hE =
      restrictState K (D ∪ E) (Finset.union_subset hD hE) := by
  letI := restrictedCarrierDecidableEq K
  apply Finset.map_injective (includeTermEmbedding K)
  rw [Finset.map_union]
  change includeState K (restrictState K D hD) ∪
      includeState K (restrictState K E hE) =
    includeState K (restrictState K (D ∪ E) (Finset.union_subset hD hE))
  rw [includeState_restrictState, includeState_restrictState,
    includeState_restrictState]

/-- Normalization preserves the endpoint union. -/
theorem normalizedLeft_union_normalizedRight
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    {A B : AmbientState U V W} (P : ExactSpanPresentation A B) :
    normalizedLeft P ∪ normalizedRight P =
      normalizeSubstate P (A ∪ B) (by rfl) := by
  letI := restrictedCarrierDecidableEq (A ∪ B)
  change
    BinaryAmbientTensorCoordinates.normalizeState P.firstCoordinates
        P.secondCoordinates P.thirdCoordinates
        (restrictState (A ∪ B) A Finset.subset_union_left) ∪
      BinaryAmbientTensorCoordinates.normalizeState P.firstCoordinates
        P.secondCoordinates P.thirdCoordinates
        (restrictState (A ∪ B) B Finset.subset_union_right) =
    BinaryAmbientTensorCoordinates.normalizeState P.firstCoordinates
      P.secondCoordinates P.thirdCoordinates
      (restrictState (A ∪ B) (A ∪ B) (by rfl))
  unfold BinaryAmbientTensorCoordinates.normalizeState
  rw [← Finset.map_union]
  congr 1
  simpa only using restrictState_union (A ∪ B) A B
    Finset.subset_union_left Finset.subset_union_right

/-- Restricting a state to its own exact spans has full first subtype span. -/
theorem firstSpan_restrictState_self
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) :
    letI := restrictedCarrierDecidableEq K
    BinaryAmbientCarrier.firstSpan (restrictState K K (by rfl)) = ⊤ := by
  letI := restrictedCarrierDecidableEq K
  apply top_unique
  rintro ⟨x, hx⟩ -
  induction hx using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨t, ht, rfl⟩
      have htk : t ∈ K := by simpa using ht
      apply Submodule.subset_span
      refine ⟨restrictTerm K t htk, ?_, rfl⟩
      unfold restrictState
      apply Finset.mem_map.mpr
      refine ⟨⟨t, htk⟩, Finset.mem_attach _ _, ?_⟩
      apply includeTerm_injective K
      change includeTerm K (restrictTerm K t htk) = t
      exact includeTerm_restrictTerm K t htk
  | zero => exact Submodule.zero_mem _
  | add x y hx hy ihx ihy => exact Submodule.add_mem _ ihx ihy
  | smul a x hx ihx => exact Submodule.smul_mem _ a ihx

/-- Restricting a state to its own exact spans has full second subtype span. -/
theorem secondSpan_restrictState_self
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) :
    letI := restrictedCarrierDecidableEq K
    BinaryAmbientCarrier.secondSpan (restrictState K K (by rfl)) = ⊤ := by
  letI := restrictedCarrierDecidableEq K
  apply top_unique
  rintro ⟨x, hx⟩ -
  induction hx using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨t, ht, rfl⟩
      have htk : t ∈ K := by simpa using ht
      apply Submodule.subset_span
      refine ⟨restrictTerm K t htk, ?_, rfl⟩
      unfold restrictState
      apply Finset.mem_map.mpr
      refine ⟨⟨t, htk⟩, Finset.mem_attach _ _, ?_⟩
      apply includeTerm_injective K
      change includeTerm K (restrictTerm K t htk) = t
      exact includeTerm_restrictTerm K t htk
  | zero => exact Submodule.zero_mem _
  | add x y hx hy ihx ihy => exact Submodule.add_mem _ ihx ihy
  | smul a x hx ihx => exact Submodule.smul_mem _ a ihx

/-- Restricting a state to its own exact spans has full third subtype span. -/
theorem thirdSpan_restrictState_self
    {U : Type u} {V : Type v} {W : Type w}
    [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
    [Module F2 U] [Module F2 V] [Module F2 W]
    [DecidableEq (AmbientCarrier U V W)]
    (K : AmbientState U V W) :
