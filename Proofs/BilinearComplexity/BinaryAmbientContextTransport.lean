omit [Module F2 U] [Module F2 V] [Module F2 W] in
private theorem unpermuteBCAState_disjoint
    {O : BinaryAmbientCarrier.State U V W}
    {D : BinaryAmbientCarrier.State W U V}
    (h : Disjoint O (permuteBCAState D)) :
    Disjoint (unpermuteBCAState O) D := by
  refine Finset.disjoint_left.mpr ?_
  intro t htO htD
  obtain ⟨⟨s₁, s₂, s₃⟩, hsO, rfl⟩ := Finset.mem_image.mp htO
  apply Finset.disjoint_left.mp h hsO
  exact Finset.mem_image.mpr ⟨_, htD, rfl⟩

