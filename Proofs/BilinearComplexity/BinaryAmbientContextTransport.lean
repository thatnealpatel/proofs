import BilinearComplexity.BinaryFiveCircuitCompiler

/-!
# Context transport for normalized binary move paths

This module gives an executable inverse lookup for the finite coordinate box of an
`ExactSpanPresentation`. It splits an arbitrary ambient context into its local and
outside parts, proves the split exact and disjoint, and transports normalized paths
into ambient coordinates while keeping the outside part fixed. The resulting paths
have explicit vertices, unchanged length, additive altitude, reconstructed endpoints,
and a constant outside-box projection at every vertex.
-/

set_option autoImplicit false

namespace BilinearComplexity.BinaryAmbientContextTransport

open BinaryCircuit
open BinaryAmbientCarrier
open BinaryAmbientMoves
open BinaryAmbientMoveTransport
open BinaryAmbientNormalization
open BinaryFiveCircuitCompiler
open NormalizedBinaryCarrier

universe u v w

variable {U : Type u} {V : Type v} {W : Type w}
variable [AddCommGroup U] [AddCommGroup V] [AddCommGroup W]
variable [Module F2 U] [Module F2 V] [Module F2 W]
variable [DecidableEq U] [DecidableEq V] [DecidableEq W]

/-- Every normalized nonzero pure coordinate term in a profile. -/
def normalizedBox (p : Profile) : State p := Finset.univ

/-- The finite exact-span box embedded in the ambient carrier. -/
def localBox {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) : BinaryAmbientCarrier.State U V W :=
  mapState (exactSpanCoordinateEmbedding P) (normalizedBox P.profile)

/-- Executably recover all local coordinate terms present in an ambient context. -/
def normalizeLocalContext {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    State P.profile :=
  (normalizedBox P.profile).filter
    (fun t => mapTerm (exactSpanCoordinateEmbedding P) t ∈ C)

/-- The terms of an ambient context outside the endpoint-generated local box. -/
def outsideContext {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    BinaryAmbientCarrier.State U V W := C \ localBox P

/-- Membership in the normalized box is automatic. -/
@[simp] theorem mem_normalizedBox {p : Profile} (t : Carrier p) :
    t ∈ normalizedBox p := Finset.mem_univ t

/-- The local box is exactly the coordinate image of the normalized box. -/
theorem localBox_eq_mapState {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) :
    localBox P = mapState (exactSpanCoordinateEmbedding P) (normalizedBox P.profile) := rfl

/-- An ambient term lies in the local box exactly when all three factors lie in the
corresponding exact spans generated by the two endpoints. -/
theorem mem_localBox_iff {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (t : BinaryAmbientCarrier.Carrier U V W) :
    t ∈ localBox P ↔
      t.1.1 ∈ firstSpan (A ∪ B) ∧
      t.2.1.1 ∈ secondSpan (A ∪ B) ∧
      t.2.2.1 ∈ thirdSpan (A ∪ B) := by
  constructor
  · intro ht
    obtain ⟨s, hs, hst⟩ := Finset.mem_image.mp ht
    rw [← hst]
    exact ⟨(P.firstCoordinates s.1.1).property,
      (P.secondCoordinates s.2.1.1).property,
      (P.thirdCoordinates s.2.2.1).property⟩
  · rintro ⟨hfirst, hsecond, hthird⟩
    let x := P.firstCoordinates.symm ⟨t.1.1, hfirst⟩
    let y := P.secondCoordinates.symm ⟨t.2.1.1, hsecond⟩
    let z := P.thirdCoordinates.symm ⟨t.2.2.1, hthird⟩
    have hx : x ≠ 0 := by
      intro hxzero
      have hsub : (⟨t.1.1, hfirst⟩ : firstSpan (A ∪ B)) = 0 := by
        calc
          _ = P.firstCoordinates x := (P.firstCoordinates.apply_symm_apply _).symm
          _ = P.firstCoordinates 0 := congrArg P.firstCoordinates hxzero
          _ = 0 := P.firstCoordinates.map_zero
      exact t.1.2 (congrArg Subtype.val hsub)
    have hy : y ≠ 0 := by
      intro hyzero
      have hsub : (⟨t.2.1.1, hsecond⟩ : secondSpan (A ∪ B)) = 0 := by
        calc
          _ = P.secondCoordinates y := (P.secondCoordinates.apply_symm_apply _).symm
          _ = P.secondCoordinates 0 := congrArg P.secondCoordinates hyzero
          _ = 0 := P.secondCoordinates.map_zero
      exact t.2.1.2 (congrArg Subtype.val hsub)
    have hz : z ≠ 0 := by
      intro hzzero
      have hsub : (⟨t.2.2.1, hthird⟩ : thirdSpan (A ∪ B)) = 0 := by
        calc
          _ = P.thirdCoordinates z := (P.thirdCoordinates.apply_symm_apply _).symm
          _ = P.thirdCoordinates 0 := congrArg P.thirdCoordinates hzzero
          _ = 0 := P.thirdCoordinates.map_zero
      exact t.2.2.2 (congrArg Subtype.val hsub)
    let s : NormalizedBinaryCarrier.Carrier P.profile :=
      (⟨x, hx⟩, ⟨y, hy⟩, ⟨z, hz⟩)
    apply Finset.mem_image.mpr
    refine ⟨s, Finset.mem_univ _, ?_⟩
    apply Prod.ext
    · apply Subtype.ext
      change (P.firstCoordinates x).1 = t.1.1
      simp only [x, P.firstCoordinates.apply_symm_apply]
    · apply Prod.ext
      · apply Subtype.ext
        change (P.secondCoordinates y).1 = t.2.1.1
        simp only [y, P.secondCoordinates.apply_symm_apply]
      · apply Subtype.ext
        change (P.thirdCoordinates z).1 = t.2.2.1
        simp only [z, P.thirdCoordinates.apply_symm_apply]

/-- Mapping the executable local lookup gives precisely the context-box intersection. -/
@[simp] theorem mapState_normalizeLocalContext {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    mapState (exactSpanCoordinateEmbedding P) (normalizeLocalContext P C) =
      C ∩ localBox P := by
  ext t
  constructor
  · intro ht
    obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp ht
    simp only [normalizeLocalContext, normalizedBox, Finset.mem_filter,
      Finset.mem_univ, true_and] at hs
    exact Finset.mem_inter.mpr ⟨hs, Finset.mem_image.mpr ⟨s, Finset.mem_univ _, rfl⟩⟩
  · intro ht
    obtain ⟨htC, htL⟩ := Finset.mem_inter.mp ht
    obtain ⟨s, _hs, hst⟩ := Finset.mem_image.mp htL
    subst t
    exact Finset.mem_image.mpr ⟨s,
      by simp [normalizeLocalContext, normalizedBox, htC], rfl⟩

/-- The outside part together with the recovered local part reconstructs the context. -/
@[simp] theorem outsideContext_union_local {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    outsideContext P C ∪
      mapState (exactSpanCoordinateEmbedding P) (normalizeLocalContext P C) = C := by
  rw [mapState_normalizeLocalContext]
  exact Finset.sdiff_union_inter C (localBox P)

/-- The outside part is disjoint from the complete local coordinate box. -/
@[simp] theorem outsideContext_disjoint_localBox {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    Disjoint (outsideContext P C) (localBox P) := by
  exact Finset.sdiff_disjoint

/-- The outside part is disjoint from the image of every normalized state. -/
@[simp] theorem outsideContext_disjoint_mapped {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    (D : State P.profile) :
    Disjoint (outsideContext P C)
      (mapState (exactSpanCoordinateEmbedding P) D) := by
  apply Finset.disjoint_of_subset_right _ (outsideContext_disjoint_localBox P C)
  intro t ht
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp ht
  exact Finset.mem_image.mpr ⟨s, Finset.mem_univ _, rfl⟩

omit [Module F2 U] [Module F2 V] [Module F2 W] in
private theorem generatedFirstSplit_union_left
    {source outputLeft outputRight : Carrier U V W}
    {D E O : BinaryAmbientCarrier.State U V W}
    (h : GeneratedFirstSplit source outputLeft outputRight D E)
    (hOD : Disjoint O D) (hOE : Disjoint O E) :
    GeneratedFirstSplit source outputLeft outputRight (O ∪ D) (O ∪ E) := by
  rcases h with ⟨hsource, houtputs, hfreshLeft, hfreshRight, hsum,
    hleftSecond, hrightSecond, hleftThird, hrightThird, rfl⟩
  have hsourceO : source ∉ O := fun hmem =>
    Finset.disjoint_left.mp hOD hmem hsource
  have hleftO : outputLeft ∉ O := by
    intro hmem
    apply Finset.disjoint_left.mp hOE hmem
    simp
  have hrightO : outputRight ∉ O := by
    intro hmem
    apply Finset.disjoint_left.mp hOE hmem
    simp
  refine ⟨Finset.mem_union_right O hsource, houtputs, ?_, ?_, hsum,
    hleftSecond, hrightSecond, hleftThird, hrightThird, ?_⟩
  · simpa [hsourceO, hleftO] using hfreshLeft
  · simpa [hsourceO, hrightO] using hfreshRight
  · ext t
    simp only [Finset.mem_insert, Finset.mem_erase, Finset.mem_union]
    by_cases htO : t ∈ O <;>
      by_cases htLeft : t = outputLeft <;>
      by_cases htRight : t = outputRight <;>
      by_cases htSource : t = source <;> simp_all

omit [Module F2 U] [Module F2 V] [Module F2 W] in
private theorem sourceThirdFlip_union_left
    {sourceLeft sourceRight targetLeft targetRight : Carrier U V W}
    {D E O : BinaryAmbientCarrier.State U V W}
    (h : SourceThirdFlip sourceLeft sourceRight targetLeft targetRight D E)
    (hOD : Disjoint O D) (hOE : Disjoint O E) :
    SourceThirdFlip sourceLeft sourceRight targetLeft targetRight (O ∪ D) (O ∪ E) := by
  rcases h with ⟨hleft, hright, hsources, hfreshLeft, hfreshRight, htargets,
    hthird, htargetLeftFirst, htargetLeftSecond, htargetLeftThird,
    htargetRightFirst, htargetRightSecond, htargetRightThird, rfl⟩
  have hleftO : sourceLeft ∉ O := fun hmem => Finset.disjoint_left.mp hOD hmem hleft
  have hrightO : sourceRight ∉ O := fun hmem => Finset.disjoint_left.mp hOD hmem hright
  have htargetLeftO : targetLeft ∉ O := by
    intro hmem
    apply Finset.disjoint_left.mp hOE hmem
    simp
  have htargetRightO : targetRight ∉ O := by
    intro hmem
    apply Finset.disjoint_left.mp hOE hmem
    simp
  refine ⟨Finset.mem_union_right O hleft, Finset.mem_union_right O hright,
    hsources, ?_, ?_, htargets, hthird, htargetLeftFirst, htargetLeftSecond,
    htargetLeftThird, htargetRightFirst, htargetRightSecond,
    htargetRightThird, ?_⟩
  · simpa [hleftO, hrightO, htargetLeftO] using hfreshLeft
  · simpa [hleftO, hrightO, htargetRightO] using hfreshRight
  · ext t
    simp only [Finset.mem_insert, Finset.mem_erase, Finset.mem_union]
    by_cases htO : t ∈ O <;>
      by_cases htTargetLeft : t = targetLeft <;>
      by_cases htTargetRight : t = targetRight <;>
      by_cases htSourceLeft : t = sourceLeft <;>
      by_cases htSourceRight : t = sourceRight <;> simp_all

omit [Module F2 U] [Module F2 V] [Module F2 W] in
private theorem directedNarrowPairReduction_union_left
    {sourceLeft sourceRight target : Carrier U V W}
    {D E O : BinaryAmbientCarrier.State U V W}
    (h : DirectedNarrowPairReduction sourceLeft sourceRight target D E)
    (hOD : Disjoint O D) (hOE : Disjoint O E) :
    DirectedNarrowPairReduction sourceLeft sourceRight target (O ∪ D) (O ∪ E) := by
  rcases h with ⟨hleft, hright, hsources, hfresh, hsecond, hthird,
    htargetFirst, htargetSecond, htargetThird, rfl⟩
  have hleftO : sourceLeft ∉ O := fun hmem => Finset.disjoint_left.mp hOD hmem hleft
  have hrightO : sourceRight ∉ O := fun hmem => Finset.disjoint_left.mp hOD hmem hright
  have htargetO : target ∉ O := by
    intro hmem
    apply Finset.disjoint_left.mp hOE hmem
    simp
  refine ⟨Finset.mem_union_right O hleft, Finset.mem_union_right O hright,
    hsources, ?_, hsecond, hthird, htargetFirst, htargetSecond, htargetThird, ?_⟩
  · simpa [hleftO, hrightO, htargetO] using hfresh
  · ext t
    simp only [Finset.mem_insert, Finset.mem_erase, Finset.mem_union]
    by_cases htO : t ∈ O <;>
      by_cases htTarget : t = target <;>
      by_cases htSourceLeft : t = sourceLeft <;>
      by_cases htSourceRight : t = sourceRight <;> simp_all

omit [Module F2 U] [Module F2 V] [Module F2 W] in
/-- Union with a background disjoint from both endpoints preserves an ordered intrinsic move. -/
theorem move_union_left {D E O : BinaryAmbientCarrier.State U V W}
    (h : Move D E) (hOD : Disjoint O D) (hOE : Disjoint O E) :
    Move (O ∪ D) (O ∪ E) := by
  cases h with
  | generatedFirstSplit hs => exact .generatedFirstSplit (generatedFirstSplit_union_left hs hOD hOE)
  | sourceThirdFlip hf => exact .sourceThirdFlip (sourceThirdFlip_union_left hf hOD hOE)
  | directedNarrowPairReduction hr => exact .directedNarrowPairReduction (directedNarrowPairReduction_union_left hr hOD hOE)

private def unpermuteBCAState (O : BinaryAmbientCarrier.State U V W) :
    BinaryAmbientCarrier.State W U V :=
  O.image fun t => (t.2.2, t.1, t.2.1)

private def unpermuteCABState (O : BinaryAmbientCarrier.State U V W) :
    BinaryAmbientCarrier.State V W U :=
  O.image fun t => (t.2.1, t.2.2, t.1)

private def unpermuteACBState (O : BinaryAmbientCarrier.State U V W) :
    BinaryAmbientCarrier.State U W V :=
  O.image fun t => (t.1, t.2.2, t.2.1)

private def unpermuteCBAState (O : BinaryAmbientCarrier.State U V W) :
    BinaryAmbientCarrier.State W V U :=
  O.image fun t => (t.2.2, t.2.1, t.1)

private def unpermuteBACState (O : BinaryAmbientCarrier.State U V W) :
    BinaryAmbientCarrier.State V U W :=
  O.image fun t => (t.2.1, t.1, t.2.2)

omit [Module F2 U] [Module F2 V] [Module F2 W] in
private theorem permuteBCAState_unpermuteBCAState
    (O : BinaryAmbientCarrier.State U V W) :
    permuteBCAState (unpermuteBCAState O) = O := by
  simp only [permuteBCAState, unpermuteBCAState, Finset.image_image]
  calc
    _ = O.image id := by
      apply Finset.image_congr
      intro t _ht
      rfl
    _ = O := Finset.image_id

