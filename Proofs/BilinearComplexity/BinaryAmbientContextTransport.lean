omit [Module F2 U] [Module F2 V] [Module F2 W] in
/-- Union with a background disjoint from both endpoints preserves an intrinsic all-mode move. -/
theorem allModeMove_union_left {D E O : BinaryAmbientCarrier.State U V W}
    (h : AllModeMove D E) (hOD : Disjoint O D) (hOE : Disjoint O E) :
    AllModeMove (O ∪ D) (O ∪ E) := by
  cases h with
  | abc hmove =>
      exact .abc (move_union_left hmove hOD hOE)
  | bca hmove hD hE =>
      refine .bca (move_union_left (O := unpermuteBCAState O) hmove ?_ ?_) ?_ ?_
      · exact unpermuteBCAState_disjoint (hD ▸ hOD)
      · exact unpermuteBCAState_disjoint (hE ▸ hOE)
      · calc
          O ∪ D = permuteBCAState (unpermuteBCAState O) ∪
              permuteBCAState _ :=
            congrArg₂ (· ∪ ·) (permuteBCAState_unpermuteBCAState O).symm hD
          _ = permuteBCAState (unpermuteBCAState O ∪ _) := by
            simpa only [permuteBCAState] using
              (Finset.image_union (f := permuteBCATerm)
                (unpermuteBCAState O) _).symm
      · calc
          O ∪ E = permuteBCAState (unpermuteBCAState O) ∪
              permuteBCAState _ :=
            congrArg₂ (· ∪ ·) (permuteBCAState_unpermuteBCAState O).symm hE
          _ = permuteBCAState (unpermuteBCAState O ∪ _) := by
            simpa only [permuteBCAState] using
              (Finset.image_union (f := permuteBCATerm)
                (unpermuteBCAState O) _).symm
  | cab hmove hD hE =>
      refine .cab (move_union_left (O := unpermuteCABState O) hmove ?_ ?_) ?_ ?_
      · exact unpermuteCABState_disjoint (hD ▸ hOD)
      · exact unpermuteCABState_disjoint (hE ▸ hOE)
      · calc
          O ∪ D = permuteCABState (unpermuteCABState O) ∪ permuteCABState _ :=
            congrArg₂ (· ∪ ·) (permuteCABState_unpermuteCABState O).symm hD
          _ = permuteCABState (unpermuteCABState O ∪ _) := by
            simpa only [permuteCABState] using
              (Finset.image_union (f := permuteCABTerm)
                (unpermuteCABState O) _).symm
      · calc
          O ∪ E = permuteCABState (unpermuteCABState O) ∪ permuteCABState _ :=
            congrArg₂ (· ∪ ·) (permuteCABState_unpermuteCABState O).symm hE
          _ = permuteCABState (unpermuteCABState O ∪ _) := by
            simpa only [permuteCABState] using
              (Finset.image_union (f := permuteCABTerm)
                (unpermuteCABState O) _).symm
  | acb hmove hD hE =>
      refine .acb (move_union_left (O := unpermuteACBState O) hmove ?_ ?_) ?_ ?_
      · exact unpermuteACBState_disjoint (hD ▸ hOD)
      · exact unpermuteACBState_disjoint (hE ▸ hOE)
      · calc
          O ∪ D = permuteACBState (unpermuteACBState O) ∪ permuteACBState _ :=
            congrArg₂ (· ∪ ·) (permuteACBState_unpermuteACBState O).symm hD
          _ = permuteACBState (unpermuteACBState O ∪ _) := by
            simpa only [permuteACBState] using
              (Finset.image_union (f := permuteACBTerm)
                (unpermuteACBState O) _).symm
      · calc
          O ∪ E = permuteACBState (unpermuteACBState O) ∪ permuteACBState _ :=
            congrArg₂ (· ∪ ·) (permuteACBState_unpermuteACBState O).symm hE
          _ = permuteACBState (unpermuteACBState O ∪ _) := by
            simpa only [permuteACBState] using
              (Finset.image_union (f := permuteACBTerm)
                (unpermuteACBState O) _).symm
  | cba hmove hD hE =>
      refine .cba (move_union_left (O := unpermuteCBAState O) hmove ?_ ?_) ?_ ?_
      · exact unpermuteCBAState_disjoint (hD ▸ hOD)
      · exact unpermuteCBAState_disjoint (hE ▸ hOE)
      · calc
          O ∪ D = permuteCBAState (unpermuteCBAState O) ∪ permuteCBAState _ :=
            congrArg₂ (· ∪ ·) (permuteCBAState_unpermuteCBAState O).symm hD
          _ = permuteCBAState (unpermuteCBAState O ∪ _) := by
            simpa only [permuteCBAState] using
              (Finset.image_union (f := permuteCBATerm)
                (unpermuteCBAState O) _).symm
      · calc
          O ∪ E = permuteCBAState (unpermuteCBAState O) ∪ permuteCBAState _ :=
            congrArg₂ (· ∪ ·) (permuteCBAState_unpermuteCBAState O).symm hE
          _ = permuteCBAState (unpermuteCBAState O ∪ _) := by
            simpa only [permuteCBAState] using
              (Finset.image_union (f := permuteCBATerm)
                (unpermuteCBAState O) _).symm
  | bac hmove hD hE =>
      refine .bac (move_union_left (O := unpermuteBACState O) hmove ?_ ?_) ?_ ?_
      · exact unpermuteBACState_disjoint (hD ▸ hOD)
      · exact unpermuteBACState_disjoint (hE ▸ hOE)
      · calc
          O ∪ D = permuteBACState (unpermuteBACState O) ∪ permuteBACState _ :=
            congrArg₂ (· ∪ ·) (permuteBACState_unpermuteBACState O).symm hD
          _ = permuteBACState (unpermuteBACState O ∪ _) := by
            simpa only [permuteBACState] using
              (Finset.image_union (f := permuteBACTerm)
                (unpermuteBACState O) _).symm
      · calc
          O ∪ E = permuteBACState (unpermuteBACState O) ∪ permuteBACState _ :=
            congrArg₂ (· ∪ ·) (permuteBACState_unpermuteBACState O).symm hE
          _ = permuteBACState (unpermuteBACState O ∪ _) := by
            simpa only [permuteBACState] using
              (Finset.image_union (f := permuteBACTerm)
                (unpermuteBACState O) _).symm

private theorem disjoint_mapState_of_disjoint_box {p : Profile}
    (f : CoordinateEmbedding p U V W)
    (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p)))
    (D : State p) : Disjoint O (mapState f D) := by
  apply Finset.disjoint_of_subset_right _ hO
  intro t ht
  obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp ht
  exact Finset.mem_image.mpr ⟨s, by simp [normalizedBox], rfl⟩

/-- Map a normalized path into ambient coordinates while adjoining one fixed disjoint background. -/
def mapPathWithBackground {p : Profile} (f : CoordinateEmbedding p U V W)
    (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p))) :
    {D E : State p} →
      MovePath (@NormalizedBinaryAllModeMove.AllModeMove p) D E →
      MovePath (AllModeMove (U := U) (V := V) (W := W))
        (O ∪ mapState f D) (O ∪ mapState f E)
  | _, _, .singleton D => .singleton (O ∪ mapState f D)
  | _, _, .snoc path h =>
      .snoc (mapPathWithBackground f O hO path)
        (allModeMove_union_left (transportNormalizedAllModeMove f h)
          (disjoint_mapState_of_disjoint_box f O hO _)
          (disjoint_mapState_of_disjoint_box f O hO _))

/-- The background path has exactly the unioned images of the normalized vertices. -/
theorem mapPathWithBackground_vertices {p : Profile}
    (f : CoordinateEmbedding p U V W) (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p)))
    {D E : State p}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove p) D E) :
    (mapPathWithBackground f O hO path).vertices =
      path.vertices.map (fun X => O ∪ mapState f X) := by
  induction path with
  | singleton =>
      simp only [mapPathWithBackground, MovePath.vertices, List.map_singleton]
  | snoc path h ih =>
      simp only [mapPathWithBackground, MovePath.vertices, ih,
        List.map_append, List.map_singleton]

/-- Characterize contextual vertices by their unique normalized source occurrence. -/
theorem mapPathWithBackground_pathVertex_iff {p : Profile}
    (f : CoordinateEmbedding p U V W) (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p)))
    {D E : State p}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove p) D E)
    (Y : BinaryAmbientCarrier.State U V W) :
    PathVertex (mapPathWithBackground f O hO path) Y ↔
      ∃ X, PathVertex path X ∧ Y = O ∪ mapState f X := by
  rw [PathVertex, mapPathWithBackground_vertices]
  constructor
  · intro hY
    obtain ⟨X, hX, hXY⟩ := List.mem_map.mp hY
    exact ⟨X, hX, hXY.symm⟩
  · rintro ⟨X, hX, rfl⟩
    exact List.mem_map.mpr ⟨X, hX, rfl⟩

/-- Adjoining a fixed background preserves the exact edge count. -/
@[simp] theorem mapPathWithBackground_length {p : Profile}
    (f : CoordinateEmbedding p U V W) (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p)))
    {D E : State p}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove p) D E) :
    (mapPathWithBackground f O hO path).length = path.length := by
  induction path with
  | singleton => simp only [mapPathWithBackground, MovePath.length]
  | snoc path h ih => simp only [mapPathWithBackground, MovePath.length, ih]

/-- The cardinality of a background-unioned coordinate image is additive. -/
theorem card_union_mapState {p : Profile}
    (f : CoordinateEmbedding p U V W) (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p))) (D : State p) :
    (O ∪ mapState f D).card = O.card + D.card := by
  rw [Finset.card_union_of_disjoint
    (disjoint_mapState_of_disjoint_box f O hO D), mapState_card]

/-- The contextual ambient path altitude is exactly background size plus local altitude. -/
@[simp] theorem mapPathWithBackground_altitude {p : Profile}
    (f : CoordinateEmbedding p U V W) (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p)))
    {D E : State p}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove p) D E) :
    (mapPathWithBackground f O hO path).altitude = O.card + path.altitude := by
  induction path with
  | singleton =>
      simp only [mapPathWithBackground, MovePath.altitude,
        card_union_mapState f O hO]
  | snoc path h ih =>
      simp only [mapPathWithBackground, MovePath.altitude, ih,
        card_union_mapState f O hO, max_add_add_left]

/-- Every vertex of a background-unioned mapped path has exactly that background outside the image box. -/
theorem mapPathWithBackground_outside {p : Profile}
    (f : CoordinateEmbedding p U V W) (O : BinaryAmbientCarrier.State U V W)
    (hO : Disjoint O (mapState f (normalizedBox p)))
    {D E : State p} {Y : BinaryAmbientCarrier.State U V W}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove p) D E)
    (hY : PathVertex (mapPathWithBackground f O hO path) Y) :
    Y \ mapState f (normalizedBox p) = O := by
  rw [PathVertex, mapPathWithBackground_vertices] at hY
  obtain ⟨X, hX, rfl⟩ := List.mem_map.mp hY
  ext t
  simp only [Finset.mem_sdiff, Finset.mem_union]
  have hOX : Disjoint O (mapState f X) :=
    disjoint_mapState_of_disjoint_box f O hO X
  have hXBox : mapState f X ⊆ mapState f (normalizedBox p) := by
    intro s hs
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hs
    exact Finset.mem_image.mpr ⟨x, by simp [normalizedBox], rfl⟩
  constructor
  · exact fun ht => ht.1.resolve_right
      (fun htX => ht.2 (hXBox htX))
  · intro htO
    exact ⟨Or.inl htO, fun htBox => Finset.disjoint_left.mp hO htO htBox⟩

/-- Specialize background path transport to the executable outside part of an arbitrary context. -/
def mapPathInContext {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    {D E : State P.profile} →
      MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E →
      MovePath (AllModeMove (U := U) (V := V) (W := W))
        (outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P) D)
        (outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P) E) :=
  mapPathWithBackground (exactSpanCoordinateEmbedding P) (outsideContext P C)
    (outsideContext_disjoint_localBox P C)

/-- A normalized left endpoint over the recovered local context reconstructs `C ∪ A`. -/
@[simp] theorem outsideContext_union_normalizedLeft
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P)
        (normalizeLocalContext P C ∪ normalizedLeft P) = C ∪ A := by
  rw [mapState_union, mapState_normalizedLeft]
  rw [← Finset.union_assoc, outsideContext_union_local]

/-- A normalized right endpoint over the recovered local context reconstructs `C ∪ B`. -/
@[simp] theorem outsideContext_union_normalizedRight
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W) :
    outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P)
        (normalizeLocalContext P C ∪ normalizedRight P) = C ∪ B := by
  rw [mapState_union, mapState_normalizedRight]
  rw [← Finset.union_assoc, outsideContext_union_local]

/-- Compile a local path over the recovered context into an ambient path with exact endpoints. -/
def mapPathInContextEndpoints {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedLeft P)
    (hE : E = normalizeLocalContext P C ∪ normalizedRight P) :
    MovePath (AllModeMove (U := U) (V := V) (W := W)) (C ∪ A) (C ∪ B) :=
  castMovePathEndpoints (mapPathInContext P C path)
    (by simp only [hD, outsideContext_union_normalizedLeft])
    (by simp only [hE, outsideContext_union_normalizedRight])

/-- Compile a reverse local path into an ambient path from `C ∪ B` to `C ∪ A`. -/
def mapPathInContextEndpointsReverse {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedRight P)
    (hE : E = normalizeLocalContext P C ∪ normalizedLeft P) :
    MovePath (AllModeMove (U := U) (V := V) (W := W)) (C ∪ B) (C ∪ A) :=
  castMovePathEndpoints (mapPathInContext P C path)
    (by simp only [hD, outsideContext_union_normalizedRight])
    (by simp only [hE, outsideContext_union_normalizedLeft])

/-- Context specialization preserves the exact list of mapped-and-unioned vertices. -/
theorem mapPathInContext_vertices {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E) :
    (mapPathInContext P C path).vertices = path.vertices.map
      (fun X => outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P) X) :=
  mapPathWithBackground_vertices _ _ _ path

/-- Characterize exact-span contextual vertices by normalized source vertices. -/
theorem mapPathInContext_pathVertex_iff
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (Y : BinaryAmbientCarrier.State U V W) :
    PathVertex (mapPathInContext P C path) Y ↔
      ∃ X, PathVertex path X ∧
        Y = outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P) X :=
  mapPathWithBackground_pathVertex_iff _ _ _ path Y

/-- Context specialization preserves path length exactly. -/
@[simp] theorem mapPathInContext_length {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E) :
    (mapPathInContext P C path).length = path.length :=
  mapPathWithBackground_length _ _ _ path

/-- Context specialization adds exactly the outside-context size to altitude. -/
@[simp] theorem mapPathInContext_altitude {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E) :
    (mapPathInContext P C path).altitude = (outsideContext P C).card + path.altitude :=
  mapPathWithBackground_altitude _ _ _ path

/-- Every contextual-path vertex has the prescribed outside part. -/
theorem mapPathInContext_outside {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile} {Y : BinaryAmbientCarrier.State U V W}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hY : PathVertex (mapPathInContext P C path) Y) :
    Y \ localBox P = outsideContext P C :=
  mapPathWithBackground_outside _ _ _ path hY

/-- Exact endpoint reindexing preserves the mapped vertex list of a forward contextual path. -/
theorem mapPathInContextEndpoints_vertices
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedLeft P)
    (hE : E = normalizeLocalContext P C ∪ normalizedRight P) :
    (mapPathInContextEndpoints P C path hD hE).vertices = path.vertices.map
      (fun X => outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P) X) := by
  rw [mapPathInContextEndpoints, castMovePathEndpoints_vertices,
    mapPathInContext_vertices]

/-- The exact-endpoint forward contextual path preserves length. -/
@[simp] theorem mapPathInContextEndpoints_length
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedLeft P)
    (hE : E = normalizeLocalContext P C ∪ normalizedRight P) :
    (mapPathInContextEndpoints P C path hD hE).length = path.length := by
  rw [mapPathInContextEndpoints, castMovePathEndpoints_length,
    mapPathInContext_length]

/-- The exact-endpoint forward contextual path has exactly additive altitude. -/
@[simp] theorem mapPathInContextEndpoints_altitude
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedLeft P)
    (hE : E = normalizeLocalContext P C ∪ normalizedRight P) :
    (mapPathInContextEndpoints P C path hD hE).altitude =
      (outsideContext P C).card + path.altitude := by
  rw [mapPathInContextEndpoints, castMovePathEndpoints_altitude,
    mapPathInContext_altitude]

/-- Every forward exact-endpoint contextual vertex has the prescribed outside part. -/
theorem mapPathInContextEndpoints_outside
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile} {Y : BinaryAmbientCarrier.State U V W}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedLeft P)
    (hE : E = normalizeLocalContext P C ∪ normalizedRight P)
    (hY : PathVertex (mapPathInContextEndpoints P C path hD hE) Y) :
    Y \ localBox P = outsideContext P C := by
  apply mapPathInContext_outside P C path
  rw [PathVertex] at hY ⊢
  rw [mapPathInContextEndpoints_vertices P C path hD hE] at hY
  rw [mapPathInContext_vertices]
  exact hY

/-- Exact endpoint reindexing preserves the mapped vertex list of a reverse contextual path. -/
theorem mapPathInContextEndpointsReverse_vertices
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedRight P)
    (hE : E = normalizeLocalContext P C ∪ normalizedLeft P) :
    (mapPathInContextEndpointsReverse P C path hD hE).vertices = path.vertices.map
      (fun X => outsideContext P C ∪ mapState (exactSpanCoordinateEmbedding P) X) := by
  rw [mapPathInContextEndpointsReverse, castMovePathEndpoints_vertices,
    mapPathInContext_vertices]

/-- The exact-endpoint reverse contextual path preserves length. -/
@[simp] theorem mapPathInContextEndpointsReverse_length
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedRight P)
    (hE : E = normalizeLocalContext P C ∪ normalizedLeft P) :
    (mapPathInContextEndpointsReverse P C path hD hE).length = path.length := by
  rw [mapPathInContextEndpointsReverse, castMovePathEndpoints_length,
    mapPathInContext_length]

/-- The exact-endpoint reverse contextual path has exactly additive altitude. -/
@[simp] theorem mapPathInContextEndpointsReverse_altitude
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedRight P)
    (hE : E = normalizeLocalContext P C ∪ normalizedLeft P) :
    (mapPathInContextEndpointsReverse P C path hD hE).altitude =
      (outsideContext P C).card + path.altitude := by
  rw [mapPathInContextEndpointsReverse, castMovePathEndpoints_altitude,
    mapPathInContext_altitude]

/-- Every reverse exact-endpoint contextual vertex has the prescribed outside part. -/
theorem mapPathInContextEndpointsReverse_outside
    {A B : BinaryAmbientCarrier.State U V W}
    (P : ExactSpanPresentation A B) (C : BinaryAmbientCarrier.State U V W)
    {D E : State P.profile} {Y : BinaryAmbientCarrier.State U V W}
    (path : MovePath (@NormalizedBinaryAllModeMove.AllModeMove P.profile) D E)
    (hD : D = normalizeLocalContext P C ∪ normalizedRight P)
    (hE : E = normalizeLocalContext P C ∪ normalizedLeft P)
    (hY : PathVertex (mapPathInContextEndpointsReverse P C path hD hE) Y) :
    Y \ localBox P = outsideContext P C := by
  apply mapPathInContext_outside P C path
  rw [PathVertex] at hY ⊢
  rw [mapPathInContextEndpointsReverse_vertices P C path hD hE] at hY
  rw [mapPathInContext_vertices]
  exact hY

end BilinearComplexity.BinaryAmbientContextTransport
